{
  "name": "fixturefolio",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first workbench for turning webhook JSON into reviewable regression fixtures.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests public index.html *.ts *.js *.json .github/workflows/*.yml",
    "format:check": "prettier --check src tests public index.html *.ts *.js *.json .github/workflows/*.yml"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
